# Conexion SQL Server EPS (usuario read-only)
# CREDENCIAL: la app lee la variable canonica del workspace EZI
#   EPS_SQL_PASSWORD  (definida UNA vez por maquina:  setx EPS_SQL_PASSWORD "...")
# y NO necesita password en este archivo. EPS_PASSWORD= aqui abajo queda solo como
# fallback legado; en instalaciones nuevas, omitirla. Inventario: D:\EZI\credenciales.yaml
EPS_SERVER=ip_server
EPS_DATABASE=_bd
EPS_USER=username
EPS_DRIVER=ODBC Driver 17 for SQL Server
EPS_TIMEOUT=120

# Configuracion del dominio
ALMACEN_WIP_PROCESO_ID=16
ALMACEN_WIP_PROCESO_NOMBRE=Almacen WIP

# Aplicacion
LOG_LEVEL=INFO
DEV=false                    # habilita CORS para dev (frontend en :5173)
